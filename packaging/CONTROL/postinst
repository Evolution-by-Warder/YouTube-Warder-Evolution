#!/bin/sh
# opkg holds its lock during postinst; helper checks dependencies after it exits.
WORKER=/usr/lib/enigma2/python/Plugins/Extensions/WarderYouTube/install_deps.sh
if [ ! -f "$WORKER" ]; then
    printf '%s\n' \
        '************************************************************' \
        'ERROR: YouTube - Warder Evolution dependency helper missing.' \
        '************************************************************'
    exit 1
fi
nohup /bin/sh "$WORKER" "$PPID" </dev/null >/dev/null 2>&1 &
printf '%s\n' \
'************************************************************' \
'Install/upgrade finished: YouTube - Warder Evolution' \
'Existing YouTube Warder Evolution settings were preserved.' \
'Automatic component check is running after opkg exits.' \
'Components: ServiceApp, ExtePlayer3, Python modules, yt-dlp.' \
'Check result: /tmp/warder-youtube-deps.log' \
'Please restart GUI to activate changes.' \
'************************************************************'
exit 0
