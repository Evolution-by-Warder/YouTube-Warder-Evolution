#!/bin/sh
# opkg may run this on upgrade; show removal only for remove/purge.
case "${1:-}" in
    remove|purge)
        echo "******************************************************************"
        echo "Removal finished: YouTube Warder Evolution"
        echo "Saved Enigma2 settings, favourites and history were preserved."
        echo "Other plugins and external components were left intact."
        echo "Please restart GUI to activate changes."
        echo "******************************************************************"
        ;;
esac
exit 0
