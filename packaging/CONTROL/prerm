#!/bin/sh
# Upgrade must not claim that the plugin was uninstalled.
case "${1:-}" in
    remove|purge)
        echo "******************************************************************"
        echo "                    YouTube Warder Evolution"
        echo "******************************************************************"
        echo "Removing YouTube Warder Evolution plugin files..."
        echo "Saved settings, favourites and history will remain untouched."
        echo "******************************************************************"
        ;;
    upgrade|deconfigure)
        echo "******************************************************************"
        echo "Preparing YouTube Warder Evolution upgrade/reinstall..."
        echo "******************************************************************"
        ;;
esac
exit 0
